# Fixed-point representation used on every wire of the circuit.
# Values are elements of the ring Z_{2^N_BIT}, interpreted as two's-complement
# fixed-point numbers with L_BIT fractional bits.  N_BIT = I_BIT + L_BIT.
N_BIT=64
I_BIT=32
L_BIT=32

# Circuit description evaluated by the parties.
CIRCUIT=circuit/circuit.netlist

# Where the dealer drops the correlated randomness and where each party reads
# its own share of it from.  One file per party.
PREPROCESSING_DIR=preprocessing

# Where each party reads the cleartext values of the input wires it owns.
INPUT_DIR=inputs

# Party 0 listens on this address, party 1 dials it.
PARTY0_ADDR=127.0.0.1:7000
